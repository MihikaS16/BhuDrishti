# Backend data directory; set to an absolute path for persistent storage.
BHU_DRISHTI_DATA_DIR=./local-data
BHU_DRISHTI_MAX_UPLOAD_BYTES=104857600
BHU_DRISHTI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Frontend setting, configured in frontend/.env.local if needed:
VITE_API_URL=http://127.0.0.1:8000/api
